{
  "name": "geohash-coordinate-converter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "node scripts/run-e2e-tests.js",
    "test:workflow": "jest --testPathPattern=\"conversion-workflow\"",
    "test:ui": "jest --testPathPattern=\"ui-interactions\"",
    "test:compatibility": "jest --testPathPattern=\"browser-compatibility\"",
    "test:optimization": "jest --testPathPattern=\"optimized-batch-processor|BatchProgressIndicator|VirtualizedResultsDisplay\"",
    "test:coverage": "jest --coverage --testPathPattern=\"e2e|integration|compatibility|optimized-batch-processor\"",
    "deploy:check": "node scripts/deploy.js",
    "deploy:verify": "node scripts/final-verification.js",
    "deploy:preview": "vercel",
    "deploy:production": "vercel --prod",
    "analyze": "ANALYZE=true npm run build",
    "analyze:server": "BUNDLE_ANALYZE=server npm run build",
    "analyze:browser": "BUNDLE_ANALYZE=browser npm run build"
  },
  "dependencies": {
    "critters": "^0.0.23",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "webpack-bundle-analyzer": "^4.10.1"
  }
}
